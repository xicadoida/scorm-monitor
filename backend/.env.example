# Copie para .env no VPS e preencha os valores reais. Nunca envie o .env ao Git.
DATABASE_URL=sqlite:///./scorm_monitor.db
FTP_PASSWORD=troque-pela-senha-do-ftp

# Gere uma chave aleatória longa (mínimo 32 caracteres) e mantenha-a privada.
AUTH_SECRET=gere-uma-chave-aleatoria-longa-e-privada
AUTH_TOKEN_TTL_SECONDS=28800
IP_HASH_SECRET=gere-outra-chave-aleatoria-longa-e-privada
TRUST_PROXY_HEADERS=true
ACCESS_LOG_RETENTION_DAYS=180

# Lista de administradores separada por vírgula.
ADMIN_EMAILS=admin@admin.com

# E-mail transacional (opcional). Use uma credencial OAuth com escopo Gmail Send.
EMAIL_PROVIDER=gmail_api
EMAIL_SENDER=contato@seu-dominio.com
EMAIL_SENDER_NAME=IACLUBE LMS
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
PUBLIC_APP_URL=https://lms.iaclube.help
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
