<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pacotes SCORM têm seu próprio index e nunca devem cair no React.
  RewriteRule ^scorm(/|$) - [L]

  # Não reescreve arquivos ou pastas que realmente existem (JS, CSS, imagens, /scorm/...)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Qualquer outra rota cai no index.html, deixando o React cuidar da navegação
  RewriteRule . /index.html [L]
</IfModule>
